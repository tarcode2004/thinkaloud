OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini
PORT=4000
APP_HOST_PORT=4001
PUBLIC_URL=http://localhost:4000
APP_HOST_URL=http://localhost:4001
BUILD_MODE=docker
DATA_DIR=./data
SESSION_SECRET=change-me

# GIT_ALLOW_SSH=1   # allow git@ SSH clones with the server key

# ── Sign in with Google (optional) ──────────────────────────────────────────────────────
# OAuth 2.0 client ID of type "Web application" (public, not a secret). Unset = no Google button.
# Its Authorized JavaScript origins must list every origin the web app is served from. See docs/DEPLOY.md.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# GOOGLE_ONE_TAP=1   # also show the One Tap prompt on the sign-in page (off by default)

# Self-hosted voice moderator instead of OpenAI Realtime (see openrealtime/README.md):
# REALTIME_BASE_URL=http://localhost:8787/v1
# REALTIME_PUBLIC_URL=https://your-tunnel.example.com/v1   # what participants' browsers reach
# REALTIME_TRANSPORT=websocket   # default; 'auto' = WebRTC first, WebSocket if ICE hasn't connected in ~4.5 s; 'webrtc' = never fall back

# ── SaaS billing (optional) ───────────────────────────────────────────────────────────────
# Off unless STRIPE_SECRET_KEY is set: self-hosted installs have no plans or limits. See docs/BILLING.md.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...            # from the Dashboard endpoint, or `stripe listen`
# STRIPE_METER_EVENT_NAME=thinkaloud_voice_minutes
# Price IDs printed by `npx tsx scripts/stripe-setup.ts` (one pair per plan id in config/billing-plans.json):
# STRIPE_PRICE_STARTER_BASE=price_...
# STRIPE_PRICE_STARTER_METERED=price_...
# STRIPE_PRICE_TEAM_BASE=price_...
# STRIPE_PRICE_TEAM_METERED=price_...
# BILLING_PLANS_FILE=config/billing-plans.json  # or BILLING_PLANS='{"currency":"usd","plans":[...]}'
# BILLING_GRACE_DAYS=3                       # past_due accounts keep running sessions this long
# BILLING_MAX_SESSION_MINUTES=120            # per-session billing cap
# BILLING_ABANDON_AFTER_MINUTES=30           # idle sessions with voice are billed after this
# BILLING_REPORT_INTERVAL_MS=60000           # meter-event reporter interval; BILLING_REPORTER=off disables it
