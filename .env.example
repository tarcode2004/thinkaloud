OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini
PORT=4000
APP_HOST_PORT=4001
PUBLIC_URL=http://localhost:4000
APP_HOST_URL=http://localhost:4001
BUILD_MODE=docker
DATA_DIR=./data
SESSION_SECRET=change-me

# GIT_ALLOW_SSH=1   # allow git@ SSH clones with the server key

# Self-hosted voice moderator instead of OpenAI Realtime (see openrealtime/README.md):
# REALTIME_BASE_URL=http://localhost:8787/v1
# REALTIME_PUBLIC_URL=https://your-tunnel.example.com/v1   # what participants' browsers reach
