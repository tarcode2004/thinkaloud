[Unit]
Description=OpenRealtime self-hosted voice server (:8787), optional, disabled by default
Documentation=file://@REPO@/openrealtime/README.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@/openrealtime
EnvironmentFile=-@REPO@/openrealtime/.env
ExecStart=@REPO@/openrealtime/.venv/bin/python -m ort
Restart=always
RestartSec=5
SyslogIdentifier=openrealtime

[Install]
WantedBy=default.target
