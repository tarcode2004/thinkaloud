[Unit]
Description=ThinkAloud Cloudflare quick tunnel (apps → 127.0.0.1:4001)
Documentation=file://@REPO@/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The public https://<random>.trycloudflare.com hostname is served at http://127.0.0.1:20252/quicktunnel,
# where thinkaloud-sync.service picks it up. It changes every time this unit restarts.
ExecStart=@CLOUDFLARED@ tunnel --no-autoupdate --metrics 127.0.0.1:20252 --url http://127.0.0.1:4001
Restart=always
RestartSec=5
SyslogIdentifier=thinkaloud-tunnel-apps

[Install]
WantedBy=default.target
